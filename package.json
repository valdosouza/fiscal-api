{
  "name": "fiscal-api",
  "version": "0.1.0",
  "private": true,
  "description": "Núcleo comum das APIs fiscais do Gestão 2027 (biblioteca — D-F17): mTLS, XMLDSig, A1 cifrado, habilitação, tentativa × voz, fonte de fatos base, migrations do banco fiscal_api",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/migrations/sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "node-forge": "^1.4.0",
    "xml-crypto": "^6.3.1"
  },
  "peerDependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/node-forge": "^1.3.14",
    "express": "^4.18.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
