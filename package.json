{
  "name": "fiscal-api",
  "version": "5.2.0",
  "private": true,
  "description": "Núcleo comum das APIs fiscais do Gestão 2027 (biblioteca — D-F17): mTLS, XMLDSig, A1 cifrado, habilitação e emitente, voz do fisco (leitura publicada por família, escritor genérico sob a trava da nota, política em peças — os roteiros são da família), fonte de fatos base, migrations do banco fiscal_api",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reading": {
      "types": "./dist/reading.d.ts",
      "default": "./dist/reading.js"
    },
    "./federal-id": {
      "types": "./dist/federal-id.d.ts",
      "default": "./dist/federal-id.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "default": "./dist/pdf.js"
    },
    "./access": {
      "types": "./dist/access.d.ts",
      "default": "./dist/access.js"
    },
    "./ibscbs-assessment": {
      "types": "./dist/ibscbs-assessment.d.ts",
      "default": "./dist/ibscbs-assessment.js"
    },
    "./merchandise-total": {
      "types": "./dist/merchandise-total.d.ts",
      "default": "./dist/merchandise-total.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "reading": [
        "dist/reading.d.ts"
      ],
      "federal-id": [
        "dist/federal-id.d.ts"
      ],
      "pdf": [
        "dist/pdf.d.ts"
      ],
      "access": [
        "dist/access.d.ts"
      ],
      "ibscbs-assessment": [
        "dist/ibscbs-assessment.d.ts"
      ],
      "merchandise-total": [
        "dist/merchandise-total.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src/migrations/sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@types/pdfkit": "0.17.6",
    "@xmldom/xmldom": "0.8.15",
    "bwip-js": "4.11.4",
    "jsonwebtoken": "9.0.3",
    "mysql2": "3.24.5",
    "node-forge": "1.4.0",
    "pdfkit": "0.20.2",
    "xml-crypto": "6.3.2"
  },
  "peerDependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/node-forge": "^1.3.14",
    "express": "^4.18.2",
    "jest": "^29.7.0",
    "jsqr": "1.4.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
